<ui:FluentWindow x:Class="WinGetTray.UpdatesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="WinGet updates"
                 Icon="app.ico"
                 Width="660" Height="580" MinWidth="520" MinHeight="380"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 FontFamily="Segoe UI Variable Text, Segoe UI"
                 FontSize="14">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="WinGet updates" ShowMaximize="True" ShowMinimize="True" />

        <Grid Grid.Row="1" Margin="20,4,20,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="16" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ui:TextBox x:Name="SearchBox" Grid.Row="0"
                        PlaceholderText="Search packages"
                        Icon="{ui:SymbolIcon Search24}"
                        ClearButtonEnabled="True"
                        TextChanged="SearchBox_TextChanged"
                        KeyDown="SearchBox_KeyDown" />

            <ui:ListView x:Name="List" Grid.Row="2"
                         SelectionMode="Extended"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         MouseDoubleClick="List_MouseDoubleClick"
                         SelectionChanged="List_SelectionChanged">
                <ui:ListView.ItemTemplate>
                    <DataTemplate>
                        <!-- Inset text from the row edge so it clears the selection indicator. -->
                        <Grid Margin="14,9,14,9">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Id}" FontSize="12" Margin="0,2,0,0"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Detail}" VerticalAlignment="Center"
                                       Margin="16,0,4,0" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        </Grid>
                    </DataTemplate>
                </ui:ListView.ItemTemplate>
            </ui:ListView>

            <TextBlock x:Name="EmptyText" Grid.Row="2" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="Nothing to update" />

            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="StatusText" Grid.Column="0" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Checking…" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button x:Name="CheckButton" Content="Check now" Appearance="Secondary"
                               Margin="0,0,8,0" Click="CheckNow_Click" />
                    <ui:Button x:Name="AllButton" Content="Update all" Appearance="Secondary"
                               Margin="0,0,8,0" Click="UpdateAll_Click" />
                    <ui:Button x:Name="SelectedButton" Content="Update selected" Appearance="Primary"
                               Click="UpdateSelected_Click" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>
